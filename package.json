{
  "name": "blockchain-voting-system",
  "version": "1.0.0",
  "description": "A comprehensive blockchain-based voting system with 7-layer architecture",
  "main": "index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/index.js",
    "client:dev": "cd client && npm start",
    "build": "cd client && npm run build",
    "test": "jest",
    "test:contracts": "truffle test",
    "compile:contracts": "truffle compile",
    "migrate:contracts": "truffle migrate",
    "deploy:local": "truffle migrate --network development",
    "deploy:testnet": "truffle migrate --network testnet",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write ."
  },
  "keywords": [
    "blockchain",
    "voting",
    "ethereum",
    "hyperledger",
    "zero-knowledge",
    "self-sovereign-identity",
    "smart-contracts"
  ],
  "author": "Blockchain Voting Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "dotenv": "^16.3.1",
    "web3": "^4.1.1",
    "@truffle/contract": "^4.6.25",
    "ethers": "^6.7.1",
    "ipfs-http-client": "^60.0.1",
    "circomlib": "^2.0.5",
    "snarkjs": "^0.7.0",
    "did-resolver": "^4.1.0",
    "ethr-did-resolver": "^8.0.0",
    "did-jwt": "^7.4.1",
    "veramo": "^4.2.0",
    "@chainlink/contracts": "^0.6.1",
    "crypto": "^1.0.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "qrcode": "^1.5.3",
    "node-forge": "^1.3.1"
  },
  "devDependencies": {
    "@truffle/hdwallet-provider": "^2.1.12",
    "truffle": "^5.11.5",
    "ganache": "^7.9.1",
    "jest": "^29.6.2",
    "supertest": "^6.3.3",
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.0",
    "eslint": "^8.46.0",
    "prettier": "^3.0.1",
    "@openzeppelin/contracts": "^4.9.3",
    "@openzeppelin/test-helpers": "^0.5.16"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
