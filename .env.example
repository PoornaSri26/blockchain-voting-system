#!/bin/bash
# Environment Variables Configuration File
# Copy this file to .env and update with your actual values

# Blockchain Configuration
export MNEMONIC="your twelve word mnemonic phrase here"
export TESTNET_RPC_URL="https://ropsten.infura.io/v3/your-project-id"
export MAINNET_RPC_URL="https://mainnet.infura.io/v3/your-project-id"
export ETHERSCAN_API_KEY="your-etherscan-api-key"

# Server Configuration
export PORT=3001
export NODE_ENV=development

# Database Configuration
export DB_HOST=localhost
export DB_PORT=5432
export DB_NAME=voting_system
export DB_USER=postgres
export DB_PASSWORD=password

# JWT Configuration
export JWT_SECRET="your-super-secret-jwt-key-here"
export JWT_EXPIRES_IN=24h

# IPFS Configuration
export IPFS_HOST=localhost
export IPFS_PORT=5001
export IPFS_PROTOCOL=http

# Oracle Configuration
export CHAINLINK_NODE_URL="https://your-chainlink-node.com"
export ORACLE_CONTRACT_ADDRESS="0x..."

# Identity Provider Configuration
export DID_REGISTRY_ADDRESS="0x..."
export VERAMO_DATABASE_PATH="./veramo-db"

# Zero Knowledge Configuration
export ZK_CIRCUIT_PATH="./circuits"
export ZK_PROVING_KEY_PATH="./proving_keys"
export ZK_VERIFICATION_KEY_PATH="./verification_keys"

# Election Configuration
export ELECTION_AUTHORITY_ADDRESS="0x..."
export VOTING_TOKEN_CONTRACT="0x..."
export MINIMUM_STAKE_AMOUNT=1000

# Security Configuration
export RATE_LIMIT_WINDOW_MS=900000
export RATE_LIMIT_MAX_REQUESTS=100
export CORS_ORIGIN="http://localhost:3000"

# Monitoring & Logging
export LOG_LEVEL=info
export SENTRY_DSN="your-sentry-dsn"
